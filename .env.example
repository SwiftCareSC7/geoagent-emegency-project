# SwiftCare GeoAgent — Frontend Environment Variables
# Copy this file to .env.local and update values as needed.
#
# IMPORTANT: Do NOT put secrets here. The following must NEVER appear in frontend env:
#   - JWT_SECRET
#   - GEMINI_API_KEY
#   - MONGO_URI
#   - GOOGLE_MAPS_API_KEY
#   - MAPBOX_ACCESS_TOKEN
#
# Backend secrets belong in server/.env (see server/.env.example)

NEXT_PUBLIC_API_URL=http://localhost:5000/api
NEXT_PUBLIC_SOCKET_URL=http://localhost:5000
