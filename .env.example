# SwiftCare GeoAgent — Frontend Environment Variables
# Copy this file to .env.local and update values as needed.
#
# IMPORTANT: Do NOT put secrets here. The following must NEVER appear in frontend env:
#   - JWT_SECRET
#   - GEMINI_API_KEY
#   - MONGO_URI
#   - GOOGLE_MAPS_API_KEY
#   - MAPBOX_ACCESS_TOKEN
#
# Backend secrets belong in server/.env (see server/.env.example)

# Local development (default)
NEXT_PUBLIC_API_URL=http://localhost:5000/api
NEXT_PUBLIC_SOCKET_URL=http://localhost:5000

# Basemap Tiles (CARTO Dark Matter)
# Free public browser key for dark operational raster basemap tiles
# Obtain at: https://carto.com/basemaps/apikey
# If unset, map operates in unauthenticated preview mode or switches to OSM
NEXT_PUBLIC_CARTO_API_KEY=

# Production (update after deploying backend to Cloud Run)
# NEXT_PUBLIC_API_URL=https://geoagent-backend-XXXX-XX.a.run.app/api
# NEXT_PUBLIC_SOCKET_URL=https://geoagent-backend-XXXX-XX.a.run.app

