{
  "schema_version": 1,
  "diagram_type": "sequence",
  "meta": {
    "title": "Web Request: Redis Cache Miss and PostgreSQL Fill",
    "output": "docs/web-request-cache-miss.html",
    "viewBox": [1080, 520],
    "column_fit": "spread",
    "animation": "trace",
    "quality_profile": "showcase",
    "views": [
      {
        "id": "full-flow",
        "label": "Full Request Lifecycle",
        "focus": ["browser", "api", "redis", "db"],
        "note": "Browser calls API, API checks Redis, cache miss queries PostgreSQL, fills Redis cache, and returns data."
      },
      {
        "id": "cache-miss",
        "label": "Cache Miss & Fallback",
        "focus": ["api", "redis", "db"],
        "note": "API checks Redis, encounters cache miss, and queries PostgreSQL primary database as source of truth."
      },
      {
        "id": "fill-cache",
        "label": "Cache Fill & Return",
        "focus": ["api", "redis", "browser"],
        "note": "API populates Redis cache with TTL and returns 200 OK JSON response to the browser."
      }
    ]
  },
  "participants": [
    { "id": "browser", "type": "external", "label": "Browser", "sublabel": "client" },
    { "id": "api", "type": "backend", "label": "API Server", "sublabel": "Express / Node" },
    { "id": "redis", "type": "database", "label": "Redis", "sublabel": "cache :6379" },
    { "id": "db", "type": "database", "label": "PostgreSQL", "sublabel": "primary :5432" }
  ],
  "segments": [
    { "from": 150, "to": 240, "label": "1. Request & Cache Check" },
    { "from": 250, "to": 340, "label": "2. Cache Miss & DB Fallback" },
    { "from": 350, "to": 435, "label": "3. Cache Fill & Response" }
  ],
  "messages": [
    { "id": "req", "from": "browser", "to": "api", "y": 165, "label": "GET /api/data", "variant": "emphasis" },
    { "id": "check-cache", "from": "api", "to": "redis", "y": 195, "label": "GET cache:key", "variant": "default" },
    { "id": "miss", "from": "redis", "to": "api", "y": 225, "label": "(nil) cache miss", "variant": "return" },
    { "id": "query-db", "from": "api", "to": "db", "y": 265, "label": "SELECT * FROM table", "variant": "emphasis" },
    { "id": "db-rows", "from": "db", "to": "api", "y": 305, "label": "return rows", "variant": "return" },
    { "id": "fill-cache", "from": "api", "to": "redis", "y": 365, "label": "SETEX cache:key 60s", "variant": "dashed" },
    { "id": "res", "from": "api", "to": "browser", "y": 405, "label": "200 OK (JSON payload)", "variant": "return" }
  ],
  "activations": [
    { "participant": "api", "from": 165, "to": 410, "type": "backend" },
    { "participant": "redis", "from": 190, "to": 230, "type": "database" },
    { "participant": "db", "from": 260, "to": 310, "type": "database" }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "1. Inbound Request & Cache Check",
      "items": [
        "Browser calls the API endpoint via HTTP GET",
        "API checks Redis cache first using a unique hashed cache key",
        "Sub-millisecond latency check (< 2ms)"
      ]
    },
    {
      "dot": "emerald",
      "title": "2. Cache Miss & Database Query",
      "items": [
        "Redis returns (nil) indicating a cache miss",
        "API executes indexed SQL query against PostgreSQL",
        "PostgreSQL fetches records from disk/buffer pool and returns rows"
      ]
    },
    {
      "dot": "violet",
      "title": "3. Cache Fill & Final Response",
      "items": [
        "API fills Redis cache with SETEX and explicit 60s TTL",
        "API serializes and returns 200 OK JSON payload to Browser",
        "Next request for this key hits Redis directly, avoiding database load"
      ]
    }
  ]
}
