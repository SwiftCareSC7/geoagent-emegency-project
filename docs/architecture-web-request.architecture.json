  "cards": [
    {
      "dot": "cyan",
      "title": "Edge & Presentation Layer",
      "items": [
        "Browser dispatches secure HTTPS requests via Cloud Edge CDN",
        "Static HTML/JS served directly with low edge latency",
        "Next.js App Server renders dynamic pages and issues backend API calls"
      ]
    },
    {
      "dot": "emerald",
      "title": "Cache-Aside Lifecycle (Redis & PostgreSQL)",
      "items": [
        "1. Read-Through Check: API queries Redis using hashed entity keys (< 2ms)",
        "2. Cache Miss: API falls back to PostgreSQL primary database via indexed SQL query",
        "3. Cache Fill: API writes data back to Redis with a bounded TTL (SETEX)",
        "4. Subsequent requests hit Redis directly, reducing database load by up to 90%"
      ]
    },
    {
      "dot": "rose",
      "title": "Security & Asynchronous Offloading",
      "items": [
        "Auth Service validates signed JWT tokens and role claims",
        "Redis and PostgreSQL isolated in a protected Data Tier security perimeter",
        "Non-blocking background jobs offloaded via Task Queue to dedicated async workers"
      ]
    }
  ]
