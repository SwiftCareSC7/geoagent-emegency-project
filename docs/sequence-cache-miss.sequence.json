  "cards": [
    {
      "dot": "cyan",
      "title": "Inbound & Auth Validation",
      "items": [
        "Browser calls the API endpoint over secure HTTPS through Edge CDN",
        "Edge CDN terminates TLS and forwards the request to backend API",
        "API verifies JWT bearer token signature and permissions with Auth Service"
      ]
    },
    {
      "dot": "emerald",
      "title": "Cache-Aside Lifecycle",
      "items": [
        "API checks Redis first for pre-warmed serialized data (< 2ms)",
        "On cache miss (nil), API falls back to PostgreSQL primary database",
        "PostgreSQL executes indexed query and returns fresh data rows",
        "API fills Redis cache with SETEX and explicit 60-second TTL"
      ]
    },
    {
      "dot": "violet",
      "title": "Decoupled Response & Async Telemetry",
      "items": [
        "API asynchronously enqueues telemetry/audit event without blocking",
        "API returns 200 OK JSON response back to Edge CDN and Web Browser",
        "Subsequent requests hit Redis cache directly, avoiding DB overhead"
      ]
    }
