# ─────────────────────────────────────────────────────────
# SwiftCare GeoAgent — Backend Environment Variables
# Copy this file to .env and update values as needed.
# NEVER commit the actual .env file.
# ─────────────────────────────────────────────────────────

# ── Application ──
PORT=5000
NODE_ENV=development
# In production, Cloud Run sets PORT automatically.
# COMMIT_SHA is set by CI/CD pipeline.

# ── Database ──
MONGO_URI=your_mongodb_connection_string
# Local: mongodb://127.0.0.1:27017/geoagent-emergency
# Atlas: mongodb+srv://user:password@cluster.mongodb.net/geoagent-emergency

# ── Authentication ──
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=30d
# Production recommendation: 7d or shorter with refresh tokens.

# ── CORS / Frontend ──
CLIENT_URL=http://localhost:3000
# Production: https://your-app.vercel.app

# ── Routing Provider ──
# Options: mock, google, mapbox, osrm
# Default: osrm (Open Source Routing Machine)
ROUTING_PROVIDER=osrm
OSRM_API_URL=https://router.project-osrm.org/route/v1/driving
GOOGLE_MAPS_API_KEY=your_google_maps_key
MAPBOX_ACCESS_TOKEN=your_mapbox_token

# ── Traffic Provider ──
# Options: mock (development), google
TRAFFIC_PROVIDER=mock
DEFAULT_FREE_FLOW_SPEED_KMH=45

# ── GeoAgent AI ──
# Backend-only: never prefix with NEXT_PUBLIC_.
AI_PROVIDER=auto
OPENCODE_API_KEY=
OPENCODE_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# ── Route Deviation Thresholds ──
ROUTE_WARNING_DISTANCE_METERS=50
ROUTE_DEVIATION_DISTANCE_METERS=100
ROUTE_CRITICAL_DISTANCE_METERS=250
BEARING_WARNING_DEGREES=30
BEARING_DEVIATION_DEGREES=60
GPS_STABILITY_WINDOW=3

# Reroute cooldown and sustained degradation confirmation
REROUTE_COOLDOWN_SECONDS=30
ROUTE_DEGRADATION_CONFIRMATIONS=2
ROUTE_RECOVERY_CONFIRMATIONS=2

# ── Incident Proximity ──
INCIDENT_PROXIMITY_RADIUS_METERS=500

# ── Decision & Dispatch Engine ──
# Prototype policy thresholds — not medically validated.
CRITICAL_ETA_THRESHOLD_MINUTES=15
MAX_ACCEPTABLE_DELAY_MINUTES=8
BACKUP_TIME_ADVANTAGE_MINUTES=5
CRITICAL_DEVIATION_DISTANCE_METERS=250
BACKUP_SEARCH_RADIUS_KM=10
MAX_ALTERNATIVE_ROUTES=3

# ── Emergency SMS Notifications (MSG91) ──
# Mode: real (production) or mock (testing)
MSG91_PROVIDER=real
MSG91_API_URL=https://control.msg91.com/api/v5/flow
MSG91_AUTH_KEY=your_msg91_auth_key
MSG91_FLOW_ID=your_msg91_flow_id
MSG91_SENDER_ID=SWFCARE